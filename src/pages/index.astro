---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lessons = (await getCollection('lessons'))
  .filter((lesson) => lesson.data.status === 'published' && lesson.data.number <= 1)
  .sort((a, b) => a.data.number - b.data.number);
---

<BaseLayout
  title="Clases de programación — Código Base"
  description="Material de las clases 0 y 1: preparación del entorno, variables y operaciones en JavaScript."
>
  <section class="shell hero">
    <div>
      <div class="eyebrow">Clases de programación</div>
      <h1>Empezamos por los <em>fundamentos.</em></h1>
      <p class="lead">Prepara tu entorno y aprende variables y operaciones en JavaScript.</p>
    </div>
  </section>

  <section class="shell section" id="clases" aria-labelledby="clases-title">
    <div class="section-head">
      <div><div class="eyebrow">Contenido disponible</div><h2 id="clases-title">Clases 0 y 1</h2></div>
    </div>
    <div class="roadmap">
      {lessons.map((lesson) => (
        <a class="module" href={`/clases/${lesson.id}/`}>
          <span class="module-index">{lesson.data.number}</span>
          <div>
            <h3>{lesson.data.title}</h3>
            <p>{lesson.data.summary}</p>
          </div>
          <div class="tags">{lesson.data.topics.map((topic) => <span class="tag">{topic}</span>)}</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
