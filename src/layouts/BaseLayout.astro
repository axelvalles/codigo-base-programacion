---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Ruta práctica para reforzar fundamentos de programación con Python, SQL, Java, JavaScript y C++.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="shell topbar">
      <a class="brand" href="/" aria-label="Código Base, inicio">
        <span class="brand-mark" aria-hidden="true">&#123; &#125;</span> Código Base
      </a>
      <nav aria-label="Navegación principal">
        <a href="/#clases">Clases</a>
        <a href="/clases/00-preparar-entorno/">Clase 0</a>
        <a href="/clases/01-variables-y-operaciones/">Clase 1</a>
        <a href="/clases/02-condicionales-y-logica/">Clase 2</a>
        <a href="/clases/03-ciclos-y-repeticion/">Clase 3</a>
        <a href="/clases/04-funciones-y-retorno/">Clase 4</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer><div class="shell">Código Base · Clases 0 a 4</div></footer>
  </body>
</html>
